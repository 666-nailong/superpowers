page {
  background-color: #F7F8FA;
  color: #1A202C;
  font-size: 28rpx;
}
.page-container {
  padding: 32rpx;
}
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.primary-btn {
  background: #1A365D;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  text-align: center;
}
.primary-btn:active {
  opacity: 0.85;
}
.secondary-btn {
  background: #FFFFFF;
  color: #1A365D;
  border: 2rpx solid #1A365D;
  border-radius: 12rpx;
  padding: 22rpx 48rpx;
  font-size: 28rpx;
  text-align: center;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A202C;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #1A365D;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  color: #A0AEC0;
  font-size: 28rpx;
}
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 18rpx;
  background: #EF4444;
  color: #fff;
  font-size: 22rpx;
}
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}
.tag-primary {
  background: rgba(26, 54, 93, 0.1);
  color: #1A365D;
}
.tag-success {
  background: rgba(16, 185, 129, 0.1);
  color: #10B981;
}
.tag-warning {
  background: rgba(245, 158, 11, 0.1);
  color: #F59E0B;
}
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  color: #A0AEC0;
}
