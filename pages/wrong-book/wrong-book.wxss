.page-container {
  padding: 0 32rpx;
  padding-bottom: 100rpx;
  padding-top: 32rpx;
}
.stats-bar {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
  font-size: 26rpx;
}
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.filter-item {
  padding: 12rpx 28rpx;
  border: 2rpx solid #E2E8F0;
  border-radius: 30rpx;
  font-size: 24rpx;
}
.filter-active {
  background: #1A365D;
  color: #fff;
  border-color: #1A365D;
}
.chapter-selector {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}
.wrong-item {
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.wi-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.wi-index { font-weight: 600; margin-right: 12rpx; }
.wi-diff { font-size: 22rpx; margin-right: 12rpx; }
.wi-status { font-size: 22rpx; padding: 2rpx 16rpx; border-radius: 4rpx; }
.wi-mastered { background: rgba(16,185,129,0.1); color: #10B981; }
.wi-not-mastered { background: rgba(239,68,68,0.1); color: #EF4444; }
.wi-question { font-size: 28rpx; line-height: 1.6; margin-bottom: 12rpx; }
.wi-meta { font-size: 22rpx; color: #A0AEC0; }
.wi-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}
.wi-btn { font-size: 24rpx; color: #1A365D; padding: 4rpx 0; }
.retry-all-btn {
  margin: 32rpx 0;
}
