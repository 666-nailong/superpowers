.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #2D2D2D;
}

.viewer-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #1A365D;
  color: #fff;
}
.viewer-back { font-size: 28rpx; padding: 8rpx 16rpx; margin-left: -8rpx; }
.viewer-title { flex: 1; font-size: 28rpx; text-align: center; margin: 0 16rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.viewer-info { font-size: 24rpx; }

.page-area {
  flex: 1;
  overflow: hidden;
  position: relative;
}
.page-swiper { height: 100%; }
.swiper-slide { display: flex; align-items: center; justify-content: center; }
.page-wrapper { position: relative; width: 100%; }
.page-image { width: 100%; display: block; }

/* 批注标记 */
.ann-marker {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  background: rgba(245,158,11,0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  transform: translate(-50%, -50%);
  z-index: 10;
}

/* 翻页 */
.page-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background: #1A365D;
}
.nav-btn { font-size: 26rpx; color: #fff; padding: 12rpx 24rpx; }
.nav-btn.disabled { opacity: 0.4; }
.nav-center { font-size: 24rpx; color: rgba(255,255,255,0.8); }

/* 右下按钮 */
.float-btns {
  position: fixed;
  right: 24rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 50;
}
.float-btn {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: #1A365D;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.3);
}
.ai-btn { background: #3B82F6; }

/* 批注面板 */
.ann-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.ann-panel {
  background: #fff;
  border-radius: 16rpx 16rpx 0 0;
  width: 100%;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.ann-panel-header {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #E2E8F0;
  font-size: 30rpx;
  font-weight: 600;
}
.ann-list { flex: 1; padding: 16rpx 32rpx; max-height: 400rpx; }
.ann-item { padding: 20rpx 0; border-bottom: 2rpx solid #E2E8F0; }
.ann-item-header { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.ann-item-user { font-size: 24rpx; color: #1A365D; font-weight: 600; }
.ann-item-like { font-size: 24rpx; }
.ann-item-content { font-size: 28rpx; line-height: 1.6; }
.ann-reply { background: #F7F8FA; border-radius: 8rpx; padding: 12rpx 16rpx; margin-top: 8rpx; font-size: 24rpx; }
.ann-reply-user { color: #1A365D; }
.ann-reply-row { display: flex; gap: 8rpx; margin-top: 8rpx; }
.ann-reply-input { flex: 1; height: 56rpx; background: #F7F8FA; border-radius: 8rpx; padding: 0 16rpx; font-size: 24rpx; }
.ann-reply-send { font-size: 24rpx; color: #1A365D; padding: 12rpx; }
.ann-add-row { display: flex; gap: 16rpx; padding: 20rpx 32rpx; border-top: 2rpx solid #E2E8F0; }
.ann-add-input { flex: 1; height: 72rpx; background: #F7F8FA; border-radius: 8rpx; padding: 0 20rpx; font-size: 26rpx; }
.ann-add-btn { background: #1A365D; color: #fff; border-radius: 8rpx; padding: 16rpx 36rpx; font-size: 26rpx; display: flex; align-items: center; }
