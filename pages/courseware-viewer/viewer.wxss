.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #2D2D2D;
}

.viewer-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #1A365D;
  color: #fff;
}
.viewer-back { font-size: 28rpx; padding: 8rpx 16rpx; margin-left: -8rpx; }
.viewer-title { flex: 1; font-size: 28rpx; text-align: center; margin: 0 16rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.viewer-info { font-size: 24rpx; }

.page-area { flex: 1; overflow: hidden; }
.page-swiper { height: 100%; }
.swiper-slide { display: flex; align-items: flex-start; justify-content: center; }
.page-image { width: 100%; }

/* 底部工具栏 */
.bottom-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 16rpx 24rpx;
  padding-bottom: env(safe-area-inset-bottom, 16rpx);
  background: #1A365D;
}
.tool-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: rgba(255,255,255,0.9);
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  position: relative;
}
.tool-btn.primary {
  background: #3B82F6;
  padding: 12rpx 32rpx;
}
.tool-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  background: #EF4444;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 批注浮动窗口 */
.float-overlay { position:fixed; left:0; right:0; bottom:100rpx; z-index:160; display:flex; justify-content:center; }
.float-panel { background:#fff; border-radius:16rpx 16rpx 0 0; width:100%; max-height:55vh; display:flex; flex-direction:column; box-shadow:0 -4rpx 20rpx rgba(0,0,0,0.15); }
.float-header { display:flex; justify-content:space-between; align-items:center; padding:20rpx 24rpx; background:#1A365D; color:#fff; border-radius:16rpx 16rpx 0 0; font-size:28rpx; }
.float-actions { display:flex; font-size:24rpx; }
.float-body { flex:1; padding:16rpx 24rpx; max-height:350rpx; overflow-y:scroll; }
.float-item { padding:16rpx 0; border-bottom:2rpx solid #E2E8F0; }
.float-item-header { display:flex; align-items:center; gap:12rpx; margin-bottom:8rpx; }
.float-item-user { font-size:22rpx; color:#1A365D; font-weight:600; }
.float-item-page { font-size:20rpx; color:#3B82F6; background:rgba(59,130,246,0.1); padding:2rpx 10rpx; border-radius:4rpx; }
.float-item-like { font-size:22rpx; flex:1; text-align:right; }
.float-item-content { font-size:26rpx; line-height:1.6; }
.float-reply { background:#F7F8FA; border-radius:6rpx; padding:8rpx 12rpx; margin-top:6rpx; font-size:22rpx; }
.float-reply-user { color:#1A365D; }
.float-item-reply { font-size:22rpx; color:#1A365D; margin-top:6rpx; }

/* AI内联聊天 */
.ai-chat-overlay { position:fixed; left:0; right:0; bottom:100rpx; z-index:150; display:flex; justify-content:center; }
.ai-chat-panel { background:#fff; border-radius:16rpx 16rpx 0 0; width:100%; max-height:60vh; display:flex; flex-direction:column; box-shadow:0 -4rpx 20rpx rgba(0,0,0,0.15); }
.ai-chat-header { display:flex; justify-content:space-between; align-items:center; padding:20rpx 24rpx; background:#1A365D; color:#fff; border-radius:16rpx 16rpx 0 0; }
.ai-chat-close { font-size:32rpx; padding:8rpx; }
.ai-chat-msgs { flex:1; padding:20rpx 24rpx; max-height:400rpx; overflow-y:scroll; }
.ai-chat-welcome { text-align:center; font-size:26rpx; color:#4A5568; padding:20rpx 0; }
.ai-chat-suggest { background:#F7F8FA; border:2rpx solid #E2E8F0; border-radius:8rpx; padding:16rpx; margin-top:12rpx; font-size:24rpx; color:#1A365D; }
.ai-msg { margin-bottom:16rpx; }
.ai-msg.user { text-align:right; }
.ai-msg.ai { text-align:left; }
.ai-msg-text { display:inline-block; max-width:85%; padding:16rpx 20rpx; border-radius:12rpx; font-size:26rpx; line-height:1.6; text-align:left; }
.ai-msg.user .ai-msg-text { background:#1A365D; color:#fff; border-bottom-right-radius:4rpx; }
.ai-msg.ai .ai-msg-text { background:#F7F8FA; color:#1A202C; border-bottom-left-radius:4rpx; }
.ai-chat-input-row { display:flex; align-items:center; padding:16rpx 24rpx; border-top:2rpx solid #E2E8F0; padding-bottom:env(safe-area-inset-bottom,16rpx); }
.ai-chat-input { flex:1; height:68rpx; background:#F7F8FA; border-radius:8rpx; padding:0 20rpx; font-size:26rpx; }
.ai-chat-send { margin-left:12rpx; padding:14rpx 32rpx; border-radius:8rpx; font-size:26rpx; background:#E2E8F0; color:#A0AEC0; }
.ai-chat-send.active { background:#1A365D; color:#fff; }

/* 图片加载状态 */
.img-wrapper { position:relative; width:100%; min-height:400rpx; }
.img-loading { position:absolute; top:0; left:0; right:0; bottom:0; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#F7F8FA; color:#A0AEC0; font-size:24rpx; gap:16rpx; }
.loading-spinner { width:48rpx; height:48rpx; border:4rpx solid #E2E8F0; border-top-color:#1A365D; border-radius:50%; animation:spin 0.8s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }

/* 全屏查看 */
.fullscreen-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #000;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fullscreen-image {
  width: 100%;
}
.fullscreen-close { display: none; }

/* 全屏翻页热区 */
.fs-prev-area {
  position: fixed; top: 0; left: 0; width: 30%; bottom: 120rpx; z-index: 301;
}
.fs-next-area {
  position: fixed; top: 0; right: 0; width: 30%; bottom: 120rpx; z-index: 301;
}

/* 全屏顶部栏 */
.fs-top-bar {
  position: fixed; top: 0; left: 0; right: 0;
  display: flex; align-items: center; justify-content: space-between;
  padding: 40rpx 32rpx;
  background: linear-gradient(to bottom, rgba(0,0,0,0.5), transparent);
  z-index: 302;
}
.fs-back {
  width: 64rpx; height: 64rpx; background: rgba(0,0,0,0.5); color: #fff;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
}
.fs-page-info {
  background: rgba(0,0,0,0.5); color: #fff; padding: 12rpx 28rpx; border-radius: 24rpx;
  font-size: 26rpx;
}

/* 全屏底部栏 */
.fs-bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; justify-content: space-between;
  padding: 32rpx;
  padding-bottom: env(safe-area-inset-bottom, 32rpx);
  background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
  z-index: 302;
}
.fs-btn {
  color: #fff; font-size: 28rpx; padding: 16rpx 40rpx;
  background: rgba(255,255,255,0.15); border-radius: 12rpx;
}
.fs-btn.disabled { opacity: 0.3; }
