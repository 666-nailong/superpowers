.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #F7F8FA;
}

.viewer-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #1A365D;
  color: #fff;
  position: relative;
}
.viewer-back { font-size: 28rpx; padding: 8rpx 16rpx; margin-left: -8rpx; }
.viewer-title { flex: 1; font-size: 28rpx; text-align: center; margin: 0 16rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.viewer-action { font-size: 24rpx; padding: 8rpx 12rpx; }

/* 内容区 */
.content-area {
  flex: 1;
  padding: 32rpx;
}

.pdf-open-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.pdf-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.pdf-title { font-size: 32rpx; font-weight: 700; color: #1A202C; margin-bottom: 12rpx; }
.pdf-desc { font-size: 26rpx; color: #A0AEC0; margin-bottom: 36rpx; }

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A202C;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #1A365D;
}

/* 批注区域 */
.annotations-section {
  padding: 32rpx;
  margin-bottom: 120rpx;
}
.annotation-preview {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #E2E8F0;
}
.annotation-preview:last-child { border-bottom: none; }
.annp-user { font-size: 22rpx; color: #1A365D; font-weight: 600; margin-bottom: 4rpx; }
.annp-text { font-size: 26rpx; color: #4A5568; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.add-ann-btn { margin-top: 24rpx; }

/* AI提问浮动按钮 */
.ai-float-btn {
  position: fixed;
  right: 32rpx;
  bottom: 64rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #1A365D;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(26,54,93,0.3);
  z-index: 50;
}
.ai-float-icon { font-size: 36rpx; }
.ai-float-label { font-size: 18rpx; margin-top: 4rpx; }

/* 批注面板 */
.annotation-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.annotation-panel {
  background: #FFFFFF;
  border-radius: 16rpx 16rpx 0 0;
  width: 100%;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}
.panel-header {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #E2E8F0;
}
.panel-title { font-size: 30rpx; font-weight: 600; }
.panel-close { font-size: 32rpx; color: #A0AEC0; padding: 4rpx 12rpx; }
.panel-body { flex: 1; padding: 16rpx 32rpx; max-height: 500rpx; }
.annotation-item { padding: 20rpx 0; border-bottom: 2rpx solid #E2E8F0; }
.ann-header { display: flex; align-items: center; margin-bottom: 8rpx; }
.ann-user { font-size: 24rpx; font-weight: 600; color: #1A365D; margin-right: 12rpx; }
.ann-time { font-size: 20rpx; color: #A0AEC0; flex: 1; }
.ann-likes { font-size: 24rpx; }
.ann-content { font-size: 26rpx; line-height: 1.6; margin-bottom: 12rpx; }
.reply-item { background: #F7F8FA; border-radius: 8rpx; padding: 12rpx 16rpx; margin-bottom: 8rpx; font-size: 24rpx; }
.reply-user { color: #1A365D; }
.reply-text { color: #4A5568; }
.reply-input-row { display: flex; gap: 8rpx; margin-top: 8rpx; }
.reply-input { flex: 1; height: 56rpx; background: #F7F8FA; border-radius: 8rpx; padding: 0 16rpx; font-size: 24rpx; }
.reply-send { font-size: 24rpx; color: #1A365D; padding: 12rpx; }
.add-annotation { display: flex; gap: 16rpx; padding: 20rpx 32rpx; border-top: 2rpx solid #E2E8F0; }
.ann-input { flex: 1; height: 72rpx; background: #F7F8FA; border-radius: 8rpx; padding: 0 20rpx; font-size: 26rpx; }
.ann-submit { padding: 16rpx 40rpx; font-size: 26rpx; }

.empty-state { text-align: center; padding: 40rpx 0; }
