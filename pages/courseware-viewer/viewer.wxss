.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #2D2D2D;
}

.viewer-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #1A365D;
  color: #fff;
}
.viewer-back { font-size: 28rpx; padding: 8rpx 16rpx; margin-left: -8rpx; }
.viewer-title { flex: 1; font-size: 28rpx; text-align: center; margin: 0 16rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.viewer-info { font-size: 24rpx; }

.page-area { flex: 1; overflow: hidden; }
.page-swiper { height: 100%; }
.swiper-slide { display: flex; align-items: flex-start; justify-content: center; }
.page-image { width: 100%; }

/* 底部工具栏 */
.bottom-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 16rpx 24rpx;
  padding-bottom: env(safe-area-inset-bottom, 16rpx);
  background: #1A365D;
}
.tool-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: rgba(255,255,255,0.9);
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  position: relative;
}
.tool-btn.primary {
  background: #3B82F6;
  padding: 12rpx 32rpx;
}
.tool-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  background: #EF4444;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 批注列表页（全屏） */
.ann-page {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #F7F8FA;
  z-index: 200;
  display: flex;
  flex-direction: column;
}
.ann-page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #1A365D;
  color: #fff;
  font-size: 30rpx;
}
.ann-page-back { font-size: 28rpx; padding: 8rpx; }
.ann-page-add { font-size: 32rpx; padding: 8rpx; }
.ann-page-body { flex: 1; padding: 24rpx; }
.ann-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.ann-card-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; flex-wrap: wrap; }
.ann-card-user { font-size: 24rpx; color: #1A365D; font-weight: 600; }
.ann-card-page { font-size: 22rpx; color: #3B82F6; background: rgba(59,130,246,0.1); padding: 2rpx 12rpx; border-radius: 4rpx; }
.ann-card-time { font-size: 20rpx; color: #A0AEC0; flex: 1; }
.ann-card-like { font-size: 24rpx; }
.ann-card-content { font-size: 28rpx; line-height: 1.7; margin-bottom: 12rpx; }
.ann-reply { background: #F7F8FA; border-radius: 8rpx; padding: 12rpx 16rpx; margin-top: 8rpx; font-size: 24rpx; }
.ann-reply-user { color: #1A365D; }
.ann-card-reply { font-size: 24rpx; color: #1A365D; margin-top: 12rpx; }

/* 全屏查看 */
.fullscreen-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #000;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fullscreen-image {
  width: 100%;
}
.fullscreen-close { display: none; }

/* 全屏翻页热区 */
.fs-prev-area {
  position: fixed; top: 0; left: 0; width: 30%; bottom: 120rpx; z-index: 301;
}
.fs-next-area {
  position: fixed; top: 0; right: 0; width: 30%; bottom: 120rpx; z-index: 301;
}

/* 全屏顶部栏 */
.fs-top-bar {
  position: fixed; top: 0; left: 0; right: 0;
  display: flex; align-items: center; justify-content: space-between;
  padding: 40rpx 32rpx;
  background: linear-gradient(to bottom, rgba(0,0,0,0.5), transparent);
  z-index: 302;
}
.fs-back {
  width: 64rpx; height: 64rpx; background: rgba(0,0,0,0.5); color: #fff;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
}
.fs-page-info {
  background: rgba(0,0,0,0.5); color: #fff; padding: 12rpx 28rpx; border-radius: 24rpx;
  font-size: 26rpx;
}

/* 全屏底部栏 */
.fs-bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; justify-content: space-between;
  padding: 32rpx;
  padding-bottom: env(safe-area-inset-bottom, 32rpx);
  background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
  z-index: 302;
}
.fs-btn {
  color: #fff; font-size: 28rpx; padding: 16rpx 40rpx;
  background: rgba(255,255,255,0.15); border-radius: 12rpx;
}
.fs-btn.disabled { opacity: 0.3; }
