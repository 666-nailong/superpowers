<view class="page-container">
  <!-- 顶部导航 -->
  <view class="viewer-header">
    <view class="viewer-back" bindtap="goBack">← 返回</view>
    <view class="viewer-title">{{title}}</view>
    <view class="viewer-info">{{currentPage}} / {{totalPages}}页</view>
  </view>

  <!-- 页面显示区 -->
  <view class="page-area">
    <swiper class="page-swiper" current="{{currentIndex}}" bindchange="onSwiperChange" circular="{{false}}">
      <swiper-item wx:for="{{pageList}}" wx:key="page" class="swiper-slide">
        <view class="img-wrapper">
          <image class="page-image" src="{{item.src}}" mode="widthFix" show-menu-by-longpress="{{true}}" bindtap="enterFullScreen" data-src="{{item.src}}" bindload="onImgLoad" binderror="onImgError" data-index="{{index}}"></image>
          <view wx:if="{{!item.loaded}}" class="img-loading">
            <view wx:if="{{item.failed}}" class="img-retry" bindtap="retryPage" data-index="{{index}}">
              <text>⚠️ 加载失败，点击重试</text>
            </view>
            <view wx:else>
              <view class="loading-spinner"></view>
              <text>加载中...</text>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 全屏查看遮罩 -->
  <view wx:if="{{fullScreen}}" class="fullscreen-mask">
    <image class="fullscreen-image" src="{{fullScreenSrc}}" mode="widthFix" show-menu-by-longpress="{{true}}"></image>
    <!-- 左右半区切页 -->
    <view class="fs-prev-area" bindtap="fsPrevPage"></view>
    <view class="fs-next-area" bindtap="fsNextPage"></view>
    <!-- 控制按钮 -->
    <view class="fs-top-bar">
      <view class="fs-back" bindtap="exitFullScreen">✕</view>
      <view class="fs-page-info">{{currentPage}} / {{totalPages}}</view>
    </view>
    <view class="fs-bottom-bar">
      <view class="fs-btn {{currentPage <= 1 ? 'disabled' : ''}}" bindtap="fsPrevPage">◀ 上一页</view>
      <view class="fs-btn {{currentPage >= totalPages ? 'disabled' : ''}}" bindtap="fsNextPage">下一页 ▶</view>
    </view>
  </view>

  <!-- 底部工具栏 -->
  <view class="bottom-toolbar">
    <view class="tool-btn" bindtap="showAnnPanel">
      <text>💬</text>
      <text class="tool-badge" wx:if="{{annCount > 0}}">{{annCount}}</text>
    </view>
    <view class="tool-btn primary" bindtap="addAnnotation">
      <text>✏️ 添加批注</text>
    </view>
    <view class="tool-btn" bindtap="toggleAIChat">
      <text>🤖 AI</text>
    </view>
  </view>

  <!-- AI 聊天面板（浮在工具栏上方） -->
  <view wx:if="{{showAIChat}}" class="ai-chat-overlay">
    <view class="ai-chat-panel">
      <view class="ai-chat-header">
        <text>🤖 电路分析AI助手</text>
        <text class="ai-chat-close" bindtap="toggleAIChat">✕</text>
      </view>
      <scroll-view class="ai-chat-msgs" scroll-y scroll-into-view="ai-msg-{{aiMsgs.length-1}}">
        <view wx:if="{{aiMsgs.length === 0}}" class="ai-chat-welcome">
          <view>关于第{{currentPage}}页的内容，有什么问题吗？</view>
          <view class="ai-chat-suggest" bindtap="aiSendSuggestion" data-q="解释一下这页的核心概念">解释一下这页的核心概念</view>
          <view class="ai-chat-suggest" bindtap="aiSendSuggestion" data-q="这页有什么公式？">这页有什么公式？</view>
        </view>
        <view wx:for="{{aiMsgs}}" wx:key="id" class="ai-msg {{item.role}}" id="ai-msg-{{index}}">
          <view class="ai-msg-text">{{item.content}}</view>
        </view>
      </scroll-view>
      <view class="ai-chat-input-row">
        <input class="ai-chat-input" placeholder="输入问题..." bindinput="onAiInput" value="{{aiInputVal}}" confirm-type="send" bindconfirm="aiSendMessage" />
        <view class="ai-chat-send {{aiInputVal.trim() ? 'active' : ''}}" bindtap="aiSendMessage">发送</view>
      </view>
    </view>
  </view>

  <!-- 批注浮动窗口 -->
  <view wx:if="{{showAnnPanel}}" class="float-overlay">
    <view class="float-panel">
      <view class="float-header">
        <text>💬 批注（{{annCount}}）</text>
        <view class="float-actions">
          <text bindtap="addAnnotation">✏️ 添加</text>
          <text bindtap="closeAnnPanel" style="margin-left:20rpx">✕</text>
        </view>
      </view>
      <scroll-view scroll-y class="float-body">
        <view wx:if="{{allAnnotations.length === 0}}" style="padding:40rpx 0;text-align:center;color:#A0AEC0;font-size:26rpx">暂无批注</view>
        <view wx:for="{{allAnnotations}}" wx:key="id" class="float-item">
          <view class="float-item-header">
            <text class="float-item-user">{{item.userName}}</text>
            <text class="float-item-page">第{{item.pageNum}}页</text>
            <text class="float-item-like" bindtap="likeAnnotation" data-id="{{item.id}}" data-page="{{item.pageNum}}">{{item.liked ? '❤️' : '🤍'}} {{item.likes}}</text>
          </view>
          <view class="float-item-content">{{item.content}}</view>
          <view wx:for="{{item.replies}}" wx:key="id" class="float-reply"><text class="float-reply-user">{{item.userName}}：</text>{{item.content}}</view>
          <view class="float-item-reply" bindtap="replyAnnotation" data-id="{{item.id}}">💬 回复</view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
