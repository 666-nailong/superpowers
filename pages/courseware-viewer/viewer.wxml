<view class="page-container">
  <!-- 顶部导航 -->
  <view class="viewer-header">
    <view class="viewer-back" bindtap="goBack">← 返回</view>
    <view class="viewer-title">{{title}}</view>
    <view class="viewer-info">{{currentPage}} / {{totalPages}}页</view>
  </view>

  <!-- 页面显示区 -->
  <view class="page-area">
    <swiper class="page-swiper" current="{{currentIndex}}" bindchange="onSwiperChange" circular="{{false}}">
      <swiper-item wx:for="{{pageList}}" wx:key="page" class="swiper-slide">
        <view class="page-wrapper">
          <image class="page-image" src="{{item.src}}" mode="widthFix" bindtap="onPageTap" data-page="{{item.page}}" show-menu-by-longpress="{{true}}"></image>
          <!-- 批注标记 -->
          <view wx:for="{{item.annotations}}" wx:key="id" class="ann-marker"
                style="left:{{item.x}}%;top:{{item.y}}%"
                bindtap="onMarkerTap" data-id="{{item.id}}">
            <text>{{item.likes > 0 ? '💬' : '💭'}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 批注弹出层 -->
  <view wx:if="{{showAnnPanel}}" class="ann-mask" bindtap="closeAnnPanel">
    <view class="ann-panel">
      <view class="ann-panel-header">
        <text>批注</text>
        <text bindtap="closeAnnPanel" style="font-size:32rpx;color:#A0AEC0;padding:8rpx">✕</text>
      </view>
      <scroll-view scroll-y class="ann-list">
        <view wx:if="{{currentAnnotations.length === 0}}" style="padding:40rpx 0;text-align:center;color:#A0AEC0;font-size:26rpx">暂无批注</view>
        <view wx:for="{{currentAnnotations}}" wx:key="id" class="ann-item">
          <view class="ann-item-header">
            <text class="ann-item-user">{{item.userName}} 第{{item.pageNum}}页</text>
            <text class="ann-item-like" bindtap="likeAnnotation" data-id="{{item.id}}">{{item.liked ? '❤️' : '🤍'}} {{item.likes}}</text>
          </view>
          <view class="ann-item-content">{{item.content}}</view>
          <view wx:for="{{item.replies}}" wx:key="id" class="ann-reply">
            <text class="ann-reply-user">{{item.userName}}：</text>
            <text>{{item.content}}</text>
          </view>
          <view class="ann-reply-row">
            <input class="ann-reply-input" placeholder="回复..." bindblur="onReplyInput" data-id="{{item.id}}" />
            <text class="ann-reply-send" bindtap="sendReply" data-id="{{item.id}}">发送</text>
          </view>
        </view>
      </scroll-view>
      <view class="ann-add-row">
        <input class="ann-add-input" placeholder="添加批注..." id="annInput" />
        <view class="ann-add-btn" bindtap="submitAnnotation">提交</view>
      </view>
    </view>
  </view>

  <!-- 翻页按钮 -->
  <view class="page-nav">
    <view class="nav-btn {{currentPage <= 1 ? 'disabled' : ''}}" bindtap="prevPage">◀ 上一页</view>
    <view class="nav-center">{{currentPage}} / {{totalPages}}</view>
    <view class="nav-btn {{currentPage >= totalPages ? 'disabled' : ''}}" bindtap="nextPage">下一页 ▶</view>
  </view>

  <!-- 右下角按钮组 -->
  <view class="float-btns">
    <view class="float-btn" bindtap="showAnnPanel">💬 {{annCount}}</view>
    <view class="float-btn ai-btn" bindtap="askAI">🤖 AI</view>
  </view>
</view>
