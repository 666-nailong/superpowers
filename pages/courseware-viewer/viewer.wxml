<view class="page-container">
  <!-- 顶部导航 -->
  <view class="viewer-header">
    <view class="viewer-back" bindtap="goBack">← 返回</view>
    <view class="viewer-title">{{title}}</view>
    <view class="viewer-info">{{currentPage}} / {{totalPages}}页</view>
  </view>

  <!-- 页面显示区 -->
  <view class="page-area">
    <swiper class="page-swiper" current="{{currentIndex}}" bindchange="onSwiperChange" circular="{{false}}">
      <swiper-item wx:for="{{pageList}}" wx:key="page" class="swiper-slide">
        <image class="page-image" src="{{item.src}}" mode="widthFix" show-menu-by-longpress="{{true}}"></image>
      </swiper-item>
    </swiper>
  </view>

  <!-- 底部工具栏 -->
  <view class="bottom-toolbar">
    <view class="tool-btn" bindtap="showAnnList">
      <text>💬</text>
      <text class="tool-badge" wx:if="{{annCount > 0}}">{{annCount}}</text>
    </view>
    <view class="tool-btn primary" bindtap="addAnnotation">
      <text>✏️ 添加批注</text>
    </view>
    <view class="tool-btn" bindtap="askAI">
      <text>🤖 AI提问</text>
    </view>
  </view>

  <!-- 批注列表页（独立页面，不是弹出层） -->
  <view wx:if="{{showAnnListPage}}" class="ann-page">
    <view class="ann-page-header">
      <text class="ann-page-back" bindtap="closeAnnList">← 返回</text>
      <text>全部批注（{{annCount}}）</text>
      <text class="ann-page-add" bindtap="addAnnotation">✏️</text>
    </view>
    <scroll-view scroll-y class="ann-page-body">
      <view wx:if="{{allAnnotations.length === 0}}" style="padding:80rpx 0;text-align:center;color:#A0AEC0;font-size:28rpx">暂无批注</view>
      <view wx:for="{{allAnnotations}}" wx:key="id" class="ann-card">
        <view class="ann-card-header">
          <text class="ann-card-user">{{item.userName}}</text>
          <text class="ann-card-page">第{{item.pageNum}}页</text>
          <text class="ann-card-time">{{item.time}}</text>
          <text class="ann-card-like" bindtap="likeAnnotation" data-id="{{item.id}}" data-page="{{item.pageNum}}">
            {{item.liked ? '❤️' : '🤍'}} {{item.likes}}
          </text>
        </view>
        <view class="ann-card-content">{{item.content}}</view>
        <view wx:for="{{item.replies}}" wx:key="id" class="ann-reply">
          <text class="ann-reply-user">{{item.userName}}：</text>
          <text>{{item.content}}</text>
        </view>
        <view class="ann-card-reply" bindtap="replyAnnotation" data-id="{{item.id}}">💬 回复</view>
      </view>
    </scroll-view>
  </view>
</view>
