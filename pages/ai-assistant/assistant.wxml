<view class="page-container">
  <!-- 顶部栏 -->
  <view class="top-bar">
    <view class="top-left">
      <text class="top-title">🤖 AI 助手</text>
      <text class="top-settings" bindtap="showSettings">⚙️</text>
    </view>
    <view class="top-right">
      <text class="top-clear" wx:if="{{msgList.length > 0}}" bindtap="clearChat">🗑️</text>
    </view>
  </view>

  <!-- 聊天区域 -->
  <scroll-view class="chat-area" scroll-y scroll-into-view="bottom-anchor" scroll-with-animation="{{true}}">
    <view class="welcome-msg" wx:if="{{msgList.length === 0}}">
      <view class="ai-icon">⚡</view>
      <view class="welcome-title">电路分析 AI 助手</view>
      <view class="welcome-desc">问任何问题～</view>
      <view wx:if="{{!hasApiKey}}" class="api-tip" bindtap="showSettings">💡 点⚙️设置API Key启用AI大模型，或使用内置问答</view>
      <view class="suggestion-list">
        <view wx:for="{{suggestions}}" wx:key="*this" class="suggestion-item" bindtap="sendSuggestion" data-item="{{item}}">{{item}}</view>
      </view>
    </view>

    <view wx:for="{{msgList}}" wx:key="id" class="msg-row {{item.role === 'user' ? 'user-row' : 'ai-row'}}">
      <view wx:if="{{item.role === 'assistant'}}" class="msg-avatar">⚡</view>
      <view class="msg-bubble {{item.role === 'user' ? 'user-bubble' : 'ai-bubble'}}">
        <rich-text wx:if="{{item.html}}" nodes="{{item.html}}" class="msg-text"></rich-text>
        <text wx:else class="msg-text">{{item.content}}</text>
        <text class="msg-time">{{item.time}}</text>
      </view>
    </view>

    <view id="bottom-anchor"></view>
  </scroll-view>

  <!-- 底部输入栏 -->
  <view class="input-bar">
    <view class="input-row">
      <input class="msg-input" placeholder="输入问题..." bindinput="onInput" value="{{inputValue}}" confirm-type="send" bindconfirm="sendMessage" cursor-spacing="100" />
      <view class="send-btn {{inputValue.trim() ? 'active' : ''}}" bindtap="sendMessage">发送</view>
    </view>
  </view>

  <!-- 设置面板 -->
  <view wx:if="{{showSettingsPanel}}" class="settings-mask">
    <view class="settings-panel">
      <view class="settings-title">⚙️ 设置</view>

      <view class="settings-field">
        <text class="settings-label">AI服务商</text>
        <picker mode="selector" range="{{apiOptions}}" bindchange="onApiSelect">
          <view class="settings-picker">{{apiOptions[apiSelected]}} ▾</view>
        </picker>
      </view>
      
      <view wx:if="{{apiCustomUrl}}" class="settings-field">
        <text class="settings-label">API地址</text>
        <input class="settings-input" placeholder="https://" value="{{apiUrl}}" bindinput="onApiUrlInput" />
      </view>

      <view class="settings-field">
        <text class="settings-label">模型</text>
        <input class="settings-input" placeholder="模型名称" value="{{apiModel}}" bindinput="onApiModelInput" />
      </view>
      
      <view class="settings-field">
        <text class="settings-label">API Key</text>
        <view class="key-row">
          <input class="settings-input key-input" placeholder="sk-..." value="{{apiKey}}" bindinput="onApiKeyInput" password="{{!showKey}}" />
          <text class="key-toggle" bindtap="toggleKeyShow">{{showKey ? '🙈' : '👁️'}}</text>
        </view>
      </view>

      <view class="settings-hint">
        <text bindtap="showFreeApiGuide" style="color:#3B82F6">🔑 免费获取API Key</text>
        <text style="color:#A0AEC0;font-size:22rpx;display:block;margin-top:8rpx">支持OpenAI兼容接口</text>
      </view>

      <view class="settings-btns">
        <view class="settings-btn secondary" bindtap="clearApiKey">清除Key</view>
        <view class="settings-btn primary" bindtap="saveSettings">保存</view>
      </view>
      <view class="settings-close" bindtap="hideSettings">关闭</view>
    </view>
  </view>
</view>
