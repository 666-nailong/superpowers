.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0;
  background: #F7F8FA;
}

/* 聊天列表 */
.chat-list {
  flex: 1;
  padding: 32rpx;
  padding-bottom: 20rpx;
}

/* 欢迎页 */
.welcome-msg {
  text-align: center;
  padding: 60rpx 32rpx;
}
.ai-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #1A365D;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin: 0 auto 24rpx;
}
.welcome-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A365D;
  margin-bottom: 16rpx;
}
.welcome-desc {
  font-size: 26rpx;
  color: #4A5568;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

/* 建议问题 */
.suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.suggestion-item {
  background: #FFFFFF;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: #1A365D;
  text-align: left;
}
.suggestion-item:active {
  background: rgba(26, 54, 93, 0.05);
  border-color: #1A365D;
}

/* 消息行 */
.msg-row {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}
.msg-user-row { justify-content: flex-end; }
.msg-ai-row { justify-content: flex-start; }

.msg-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #1A365D;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.msg-bubble {
  max-width: 75%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  position: relative;
}
.msg-user {
  background: #2B4C7E;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}
.msg-ai {
  background: #FFFFFF;
  color: #1A202C;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.msg-text { white-space: pre-wrap; word-break: break-word; }
.msg-time {
  font-size: 20rpx;
  color: #A0AEC0;
  margin-top: 8rpx;
  text-align: right;
}

/* 输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-top: 2rpx solid #E2E8F0;
  padding-bottom: env(safe-area-inset-bottom, 16rpx);
}
.msg-input {
  flex: 1;
  height: 72rpx;
  background: #F7F8FA;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}
.send-btn {
  margin-left: 16rpx;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  background: #E2E8F0;
  color: #A0AEC0;
}
.send-btn.send-active {
  background: #1A365D;
  color: #fff;
}

/* 顶部栏 */
.top-bar { display:flex; align-items:center; justify-content:space-between; padding:20rpx 24rpx; background:#1A365D; color:#fff; }
.top-title { font-size:28rpx; font-weight:600; }
.top-settings { font-size:28rpx; padding:8rpx; }

/* 提示 */
.api-tip { font-size:22rpx; color:#3B82F6; background:rgba(59,130,246,0.1); padding:12rpx 20rpx; border-radius:8rpx; margin:16rpx 0; }

/* 设置面板 */
.settings-mask { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.4); z-index:100; display:flex; align-items:center; justify-content:center; }
.settings-panel { background:#fff; border-radius:16rpx; padding:40rpx; width:650rpx; max-height:80vh; }
.settings-title { font-size:32rpx; font-weight:700; text-align:center; margin-bottom:32rpx; }
.settings-field { position:relative; margin-bottom:24rpx; }
.settings-label { font-size:24rpx; color:#4A5568; display:block; margin-bottom:8rpx; }
.settings-input { width:100%; height:72rpx; background:#F7F8FA; border:2rpx solid #E2E8F0; border-radius:8rpx; padding:0 24rpx; font-size:26rpx; box-sizing:border-box; }
.settings-toggle { position:absolute; right:16rpx; bottom:16rpx; font-size:28rpx; }
.settings-hint { font-size:22rpx; color:#A0AEC0; margin-bottom:24rpx; line-height:1.5; }
.settings-btns { display:flex; gap:16rpx; }
.settings-btn { flex:1; text-align:center; padding:20rpx; border-radius:12rpx; font-size:28rpx; }
.settings-btn.primary { background:#1A365D; color:#fff; }
.settings-btn.secondary { background:#fff; color:#EF4444; border:2rpx solid #EF4444; }
.settings-close { text-align:center; margin-top:16rpx; font-size:26rpx; color:#A0AEC0; padding:12rpx; }
