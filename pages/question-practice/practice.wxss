.page-container {
  padding: 0 32rpx;
  padding-bottom: 160rpx;
  padding-top: 20rpx;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}
.top-title { font-size: 28rpx; font-weight: 600; }
.top-progress { font-size: 24rpx; color: #A0AEC0; margin-top: 4rpx; }
.top-timer {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A365D;
  font-variant-numeric: tabular-nums;
}
.top-timer.warning { color: #EF4444; }

/* 题目卡片 */
.question-card { padding: 32rpx; }
.q-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.q-type-badge {
  background: rgba(26,54,93,0.1);
  color: #1A365D;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}
.q-difficulty { font-size: 22rpx; color: #F59E0B; }
.q-content {
  font-size: 32rpx;
  line-height: 1.6;
  font-weight: 500;
  margin-bottom: 32rpx;
}

/* 选项 */
.q-options { margin-bottom: 8rpx; }
.q-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s;
}
.q-option:active { border-color: #1A365D; }
.option-radio {
  width: 40rpx; height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.radio-dot {
  width: 24rpx; height: 24rpx;
  border-radius: 50%;
  background: #1A365D;
}
.option-text { flex: 1; font-size: 28rpx; }
.option-mark { font-size: 32rpx; color: #10B981; margin-left: 12rpx; }

/* 选中/正确/错误状态 */
.option-selected {
  border-color: #1A365D;
  background: rgba(26,54,93,0.05);
}
.option-correct {
  border-color: #10B981;
  background: rgba(16,185,129,0.08);
}
.option-wrong {
  border-color: #EF4444;
  background: rgba(239,68,68,0.08);
}
.option-reveal-correct {
  border-color: #10B981;
  background: rgba(16,185,129,0.08);
}

/* 解析 */
.explanation-card { padding: 32rpx; }
.explanation-title { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.explanation-answer { font-size: 26rpx; color: #10B981; margin-bottom: 12rpx; }
.explanation-text { font-size: 26rpx; color: #4A5568; line-height: 1.8; }

/* 底部导航 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 16rpx 32rpx;
  padding-bottom: env(safe-area-inset-bottom, 16rpx);
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
}
.bottom-inner {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.nav-btn { flex: 1; }
.btn-disabled { opacity: 0.5; }

/* 答题卡弹出层 */
.sheet-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet-panel {
  background: #FFFFFF;
  border-radius: 16rpx 16rpx 0 0;
  padding: 40rpx;
  width: 100%;
}
.sheet-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; text-align: center; }
.sheet-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}
.sheet-grid .sheet-cell {
  width: 18%;
  margin: 0 1% 16rpx;
}
.sheet-cell {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #E2E8F0;
  border-radius: 8rpx;
  font-size: 28rpx;
}
.sheet-answered { background: #1A365D; color: #fff; border-color: #1A365D; }
.sheet-current { border-color: #1A365D; border-width: 4rpx; }
.sheet-info { text-align: center; font-size: 24rpx; color: #A0AEC0; margin-bottom: 16rpx; }
