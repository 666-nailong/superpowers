.page-container {
  padding: 0 32rpx;
  padding-bottom: 100rpx;
  padding-top: 32rpx;
}
.chapter-card {
  padding: 0;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.ch-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
}
.ch-title-wrap {
  display: flex;
  align-items: center;
  flex: 1;
}
.ch-num-badge {
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  background: #1A365D;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.ch-title-text { font-size: 28rpx; font-weight: 600; }
.ch-toggle {
  font-size: 36rpx;
  color: #A0AEC0;
  transition: transform 0.2s;
}
.ch-toggle.expanded { transform: rotate(90deg); }

.ch-files {
  border-top: 2rpx solid #E2E8F0;
}
.file-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 2rpx solid #E2E8F0;
}
.file-item:last-child { border-bottom: none; }
.file-icon { font-size: 32rpx; margin-right: 20rpx; }
.file-info { flex: 1; }
.file-title { font-size: 26rpx; }
.file-meta { font-size: 22rpx; color: #A0AEC0; margin-top: 4rpx; }
.file-arrow { font-size: 32rpx; color: #A0AEC0; }
