<view class="page-container">
  <!-- 搜索框 -->
  <view class="search-box">
    <text class="search-icon">🔍</text>
    <input class="search-input" placeholder="搜索公式..." bindinput="onSearchInput" bindconfirm="doSearch" />
    <text wx:if="{{searchQuery}}" class="search-clear" bindtap="clearSearch">✕</text>
  </view>

  <!-- 搜索结果 -->
  <view wx:if="{{searchQuery}}" class="card search-results">
    <view wx:if="{{searchResults.length === 0}}" class="empty-state">未找到匹配的公式</view>
    <view wx:for="{{searchResults}}" wx:key="id" class="formula-item">
      <view class="formula-latex">{{item.latex}}</view>
      <view class="formula-title">{{item.title}}</view>
      <view class="formula-desc">{{item.description}}</view>
    </view>
  </view>

  <!-- 分类列表 -->
  <view wx:for="{{categories}}" wx:key="id" class="formula-category">
    <view class="section-title">{{item.title}}</view>
    <view class="card">
      <view wx:for="{{item.formulas}}" wx:for-item="f" wx:key="id" class="formula-item">
        <view class="formula-header">
          <view class="formula-latex">{{f.latex}}</view>
          <view class="formula-fav {{f.favorited ? 'fav-active' : ''}}" bindtap="toggleFavorite" data-id="{{f.id}}">
            {{f.favorited ? '★' : '☆'}}
          </view>
        </view>
        <view class="formula-title">{{f.title}}</view>
        <view class="formula-desc">{{f.description}}</view>
        <view wx:if="{{f.tags}}" class="formula-tags">
          <text wx:for="{{f.tags}}" wx:key="*this" class="tag tag-primary">{{item}}</text>
        </view>
        <view wx:if="{{f.derivation}}" class="derivation-area">
          <view class="derivation-toggle" bindtap="toggleDerivation" data-id="{{f.id}}">
            {{expandedDerivation === f.id ? '🔼 收起推导' : '🔽 查看推导过程'}}
          </view>
          <view wx:if="{{expandedDerivation === f.id}}" class="derivation-content">{{f.derivation}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
