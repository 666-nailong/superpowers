.page-container {
  padding: 0 32rpx;
  padding-bottom: 120rpx;
  padding-top: 32rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
}
.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #1A365D;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}
.profile-name {
  font-size: 36rpx;
  font-weight: 700;
}
.profile-motto {
  font-size: 24rpx;
  color: #A0AEC0;
  margin-top: 8rpx;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
}
.stat-grid .stat-item {
  width: 33.33%;
  margin-bottom: 24rpx;
}
.stat-item { text-align: center; }
.stat-val { font-size: 36rpx; font-weight: 700; color: #1A365D; }
.stat-lbl { font-size: 22rpx; color: #A0AEC0; margin-top: 8rpx; }

.mock-history {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #E2E8F0;
}
.mock-history-title { font-size: 26rpx; font-weight: 600; margin-bottom: 16rpx; }
.mock-record {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  padding: 12rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #E2E8F0;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 32rpx; margin-right: 24rpx; width: 40rpx; }
.menu-label { flex: 1; font-size: 28rpx; }
.menu-badge {
  background: #EF4444;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}
.menu-arrow { font-size: 36rpx; color: #A0AEC0; }
