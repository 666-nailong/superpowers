<view class="container">
  <view class="header">
    <view class="back" bindtap="goBack">← 返回</view>
    <view class="title">{{examTitle}}</view>
    <view class="info">{{qIndex}}/{{totalQ}}题</view>
    <view class="sheet-btn" bindtap="toggleSheet">📋</view>
  </view>

  <scroll-view scroll-y class="scroll-area">
    <!-- 电路图图片 -->
    <image wx:if="{{hasImage}}" class="exam-img" src="{{currentImg}}" mode="widthFix" show-menu-by-longpress="{{true}}"></image>

    <!-- 题目 -->
    <view class="q-card">
      <view class="q-tag">{{qType}}</view>
      <view class="q-num-text">第{{qIndex}}题（共{{totalQ}}题）</view>
      <view class="q-text">{{qText}}</view>

      <!-- 选项 -->
      <view wx:if="{{options.length > 0}}" class="opt-list">
        <view wx:for="{{options}}" wx:for-item="opt" wx:key="index"
          class="opt-item {{userChoice === opt.k ? 'selected' : ''}}"
          bindtap="selectOpt" data-key="{{opt.k}}">
          <view class="opt-radio">{{userChoice === opt.k ? '●' : '○'}}</view>
          <view class="opt-text"><text class="opt-label">{{opt.k}}.</text> {{opt.t}}</view>
        </view>
      </view>

      <!-- 判断题按钮 -->
      <view wx:elif="{{qType === '判断题'}}" class="judge-row">
        <view class="judge-opt {{userChoice === '对' ? 'selected' : ''}}" bindtap="selectJudge" data-val="对">✅ 对</view>
        <view class="judge-opt {{userChoice === '错' ? 'selected' : ''}}" bindtap="selectJudge" data-val="错">❌ 错</view>
      </view>

      <!-- 填空/简答输入 -->
      <view wx:else>
        <input class="text-input" placeholder="输入答案..." bindinput="onInput" value="{{userInput}}" />
      </view>
    </view>

    <!-- 导航栏 -->
    <view class="nav-row">
      <view class="nav-btn {{qIndex <= 1 ? 'disabled' : ''}}" bindtap="prevQ">◀ 上一题</view>
      <view class="nav-dot {{answered ? 'done' : ''}}">{{answered ? '✅' : '⬜'}}</view>
      <view class="nav-btn {{qIndex >= totalQ ? 'disabled' : ''}}" bindtap="nextQ">下一题 ▶</view>
    </view>

    <!-- 提交全部按钮 -->
    <view wx:if="{{!submitted && totalAnswered === totalQ}}" class="submit-all-btn primary-btn" bindtap="submitAll">📝 提交全部答案</view>

    <!-- 成绩单 -->
    <view wx:if="{{submitted}}" class="result-card">
      <view class="result-title">📊 答题结果</view>
      <view class="result-score">{{score}}分</view>
      <view class="result-detail">正确 {{correctCount}}/{{totalQ}} 题（{{accuracy}}%）</view>
      <view class="result-bar">
        <view class="result-fill" style="width:{{accuracy}}%"></view>
      </view>
      <view wx:for="{{results}}" wx:key="index" class="result-item">
        <text class="ri-status">{{item.correct ? '✅' : '❌'}}</text>
        <text class="ri-num">第{{item.idx}}题</text>
        <text class="ri-user">你的答案: {{item.userAnswer}}</text>
        <text wx:if="!item.correct" class="ri-correct">正确答案: {{item.correctAnswer}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 答题卡弹出层 -->
  <view wx:if="{{showSheet}}" class="sheet-mask" bindtap="toggleSheet">
    <view class="sheet-panel" catchtap="">
      <view class="sheet-title">答题卡</view>
      <view class="sheet-grid">
        <view wx:for="{{answerStatus}}" wx:key="index"
          class="sheet-cell {{item ? 'done' : ''}} {{index + 1 === qIndex ? 'current' : ''}}"
          bindtap="jumpTo" data-idx="{{index}}">{{index + 1}}</view>
      </view>
      <view class="sheet-info">已答 {{totalAnswered}}/{{totalQ}} 题</view>
      <view class="sheet-close secondary-btn" bindtap="toggleSheet">关闭</view>
    </view>
  </view>
</view>
