<view class="container">
  <view class="header">
    <view class="back" bindtap="goBack">← 返回</view>
    <view class="title">{{examTitle}}</view>
    <view class="info">{{qIndex}}/{{totalQ}}题</view>
  </view>

  <scroll-view scroll-y class="scroll-area">
    <!-- 仅含电路图的题才显示原卷图片 -->
    <view wx:if="{{hasImage}}" class="img-section">
      <image class="exam-img" src="{{currentImg}}" mode="widthFix" show-menu-by-longpress="{{true}}"></image>
      <view class="img-label">↑ 题目电路图（原卷第{{imgPage}}页）</view>
    </view>

    <!-- 题目卡片 -->
    <view class="q-card">
      <view class="q-header">
        <text class="q-tag">{{qType}}</text>
        <text class="q-num">第{{qIndex}}题 / 共{{totalQ}}题</text>
      </view>
      <view class="q-text">{{qText}}</view>

      <!-- 答案输入 -->
      <view wx:if="{{!answered}}" class="answer-area">
        <input class="answer-input" placeholder="{{inputHint}}" bindinput="onAnswer" focus="{{autoFocus}}" />
        <view class="submit-btn" bindtap="submitAnswer">提交答案</view>
      </view>

      <!-- 批改结果 -->
      <view wx:if="{{answered}}" class="result-area">
        <view class="result-icon">{{isCorrect ? '✅' : '❌'}}</view>
        <view class="result-text">
          <view class="result-judge">{{isCorrect ? '回答正确！' : '回答错误'}}</view>
          <view wx:if="!isCorrect" class="result-correct-answer">正确答案：{{correctAnswer}}</view>
          <view wx:if="{{explanation}}" class="result-explanation">{{explanation}}</view>
        </view>
      </view>
    </view>

    <!-- 下一题按钮 -->
    <view wx:if="{{answered && !finished}}" class="next-btn primary-btn" bindtap="nextQuestion">
      {{qIndex < totalQ ? '下一题 →' : '完成练习 🎉'}}
    </view>

    <!-- 完成页面 -->
    <view wx:if="{{finished}}" class="finish-card">
      <view class="finish-icon">🎉</view>
      <view class="finish-title">练习完成！</view>
      <view class="finish-stats">
        <text>正确：{{correctCount}}/{{totalAnswered}}</text>
        <text>正确率：{{accuracy}}%</text>
      </view>
      <view class="finish-btn secondary-btn" bindtap="goBack">返回题库</view>
    </view>
  </scroll-view>
</view>
