.container { display:flex; flex-direction:column; height:100vh; background:#F7F8FA; }
.header { display:flex; align-items:center; padding:20rpx 24rpx; background:#1A365D; color:#fff; }
.back { font-size:28rpx; padding:8rpx 16rpx; margin-left:-8rpx; }
.title { flex:1; font-size:28rpx; text-align:center; }
.info { font-size:24rpx; margin-right:16rpx; }
.sheet-btn { font-size:32rpx; padding:8rpx; }

.scroll-area { flex:1; padding:24rpx; padding-bottom:40rpx; }

.exam-img { width:100%; border-radius:12rpx; border:2rpx solid #E2E8F0; margin-bottom:16rpx; }
.exam-img-wrapper { position:relative; width:100%; min-height:300rpx; }
.img-loading { position:absolute; top:0; left:0; right:0; bottom:0; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#F7F8FA; color:#A0AEC0; font-size:24rpx; gap:16rpx; }
.loading-spinner { width:48rpx; height:48rpx; border:4rpx solid #E2E8F0; border-top-color:#1A365D; border-radius:50%; animation:spin 0.8s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }

.q-card { background:#fff; border-radius:16rpx; padding:32rpx; margin-bottom:16rpx; box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04); }
.q-tag { display:inline-block; background:#1A365D; color:#fff; font-size:22rpx; padding:4rpx 16rpx; border-radius:4rpx; margin-bottom:12rpx; }
.q-num-text { font-size:22rpx; color:#A0AEC0; margin-bottom:16rpx; }
.q-text { font-size:30rpx; line-height:1.7; font-weight:500; margin-bottom:24rpx; white-space:pre-wrap; }

/* 选项列表 */
.opt-list { margin-bottom:8rpx; }
.opt-item { display:flex; align-items:flex-start; padding:20rpx 16rpx; border:2rpx solid #E2E8F0; border-radius:12rpx; margin-bottom:12rpx; }
.opt-item.selected { border-color:#1A365D; background:rgba(26,54,93,0.05); }
.opt-item.correct { border-color:#10B981; background:rgba(16,185,129,0.08); }
.opt-item.wrong { border-color:#EF4444; background:rgba(239,68,68,0.08); }
.opt-radio { font-size:28rpx; color:#1A365D; margin-right:16rpx; margin-top:4rpx; flex-shrink:0; width:30rpx; }
.opt-text { font-size:28rpx; line-height:1.6; }
.opt-label { font-weight:600; }

/* 判断题 */
.judge-row { display:flex; gap:20rpx; }
.judge-opt { flex:1; text-align:center; padding:28rpx; border:2rpx solid #E2E8F0; border-radius:12rpx; font-size:32rpx; }
.judge-opt.selected { border-color:#1A365D; background:rgba(26,54,93,0.1); font-weight:700; }

/* 文本输入 */
.text-input { width:100%; height:80rpx; background:#F7F8FA; border:2rpx solid #E2E8F0; border-radius:12rpx; padding:0 24rpx; font-size:28rpx; box-sizing:border-box; }

/* 导航 */
.nav-row { display:flex; align-items:center; justify-content:space-between; background:#fff; border-radius:12rpx; padding:16rpx 24rpx; margin-bottom:24rpx; }
.nav-btn { font-size:26rpx; color:#1A365D; padding:12rpx; }
.nav-btn.disabled { color:#A0AEC0; }
.nav-dot { font-size:28rpx; }

/* 提交全部 */
.submit-all-btn { margin-bottom:32rpx; }
.primary-btn { background:#1A365D; color:#fff; border-radius:12rpx; padding:24rpx; text-align:center; font-size:28rpx; }

/* 成绩单 */
.result-card { background:#fff; border-radius:16rpx; padding:32rpx; margin-bottom:32rpx; }
.result-title { font-size:32rpx; font-weight:700; text-align:center; margin-bottom:16rpx; }
.result-score { font-size:80rpx; font-weight:700; color:#1A365D; text-align:center; }
.result-detail { text-align:center; color:#4A5568; font-size:26rpx; margin:8rpx 0 20rpx; }
.result-bar { height:12rpx; background:#E2E8F0; border-radius:6rpx; overflow:hidden; margin-bottom:24rpx; }
.result-fill { height:100%; background:#1A365D; border-radius:6rpx; }
.result-item { display:flex; flex-wrap:wrap; align-items:center; gap:8rpx; padding:16rpx; border-bottom:2rpx solid #E2E8F0; font-size:24rpx; }
.ri-status { font-size:28rpx; }
.ri-num { font-weight:600; width:60rpx; }
.ri-user { flex:1; color:#4A5568; }
.ri-correct { width:100%; color:#10B981; margin-top:4rpx; }

/* 答题卡 */
.sheet-mask { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.4); z-index:100; display:flex; align-items:flex-end; }
.sheet-panel { background:#fff; border-radius:16rpx 16rpx 0 0; width:100%; padding:40rpx; }
.sheet-title { font-size:32rpx; font-weight:600; text-align:center; margin-bottom:24rpx; }
.sheet-grid { display:flex; flex-wrap:wrap; gap:12rpx; margin-bottom:24rpx; }
.sheet-cell { width:72rpx; height:72rpx; display:flex; align-items:center; justify-content:center; border:2rpx solid #E2E8F0; border-radius:8rpx; font-size:26rpx; }
.sheet-cell.done { background:#1A365D; color:#fff; border-color:#1A365D; }
.sheet-cell.current { border-color:#1A365D; border-width:4rpx; }
.sheet-info { text-align:center; font-size:24rpx; color:#A0AEC0; margin-bottom:16rpx; }
.sheet-close { text-align:center; }
.secondary-btn { background:#fff; color:#1A365D; border:2rpx solid #1A365D; border-radius:12rpx; padding:22rpx; font-size:28rpx; }
