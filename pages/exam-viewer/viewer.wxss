.container { display: flex; flex-direction: column; height: 100vh; background: #F7F8FA; }
.header { display: flex; align-items: center; padding: 20rpx 24rpx; background: #1A365D; color: #fff; position: relative; z-index:10; }
.back { font-size: 28rpx; padding: 8rpx 16rpx; margin-left: -8rpx; }
.title { flex: 1; font-size: 28rpx; text-align: center; }
.info { font-size: 24rpx; }
.scroll-area { flex: 1; padding: 24rpx; padding-bottom: 40rpx; }

.exam-img { width: 100%; border-radius: 12rpx; border: 2rpx solid #E2E8F0; }
.img-label { font-size: 20rpx; color: #A0AEC0; text-align: center; margin: 8rpx 0 24rpx; }

.q-card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.q-header { display: flex; align-items: center; margin-bottom: 20rpx; }
.q-tag { background: #1A365D; color: #fff; font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 4rpx; margin-right: 12rpx; }
.q-num { font-size: 22rpx; color: #A0AEC0; }
.q-text { font-size: 30rpx; line-height: 1.7; font-weight: 500; margin-bottom: 24rpx; }

.answer-area { }
.answer-input { width: 100%; height: 72rpx; background: #F7F8FA; border: 2rpx solid #E2E8F0; border-radius: 12rpx; padding: 0 24rpx; font-size: 28rpx; box-sizing: border-box; }
.submit-btn { background: #1A365D; color: #fff; border-radius: 12rpx; padding: 24rpx; text-align: center; font-size: 28rpx; margin-top: 20rpx; }

.result-area { display: flex; align-items: flex-start; gap: 20rpx; padding: 24rpx; background: #F7F8FA; border-radius: 12rpx; }
.result-icon { font-size: 48rpx; }
.result-text { flex: 1; }
.result-judge { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.result-correct-answer { font-size: 24rpx; color: #10B981; margin-bottom: 4rpx; }
.result-explanation { font-size: 24rpx; color: #4A5568; line-height: 1.6; margin-top: 8rpx; padding: 12rpx; background: #fff; border-radius: 8rpx; }

.next-btn { margin-top: 8rpx; margin-bottom: 32rpx; }

.finish-card { text-align: center; padding: 60rpx 0; }
.finish-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.finish-title { font-size: 36rpx; font-weight: 700; margin-bottom: 16rpx; }
.finish-stats { font-size: 28rpx; color: #4A5568; margin-bottom: 32rpx; display: flex; flex-direction: column; gap: 8rpx; }
.finish-btn { width: 300rpx; margin: 0 auto; }

.primary-btn { background: #1A365D; color: #fff; border-radius: 12rpx; padding: 24rpx; text-align: center; font-size: 28rpx; }
.secondary-btn { background: #fff; color: #1A365D; border: 2rpx solid #1A365D; border-radius: 12rpx; padding: 22rpx; text-align: center; font-size: 28rpx; }
