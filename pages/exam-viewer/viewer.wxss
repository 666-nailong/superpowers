.container { display: flex; flex-direction: column; height: 100vh; background: #F7F8FA; }
.header { display: flex; align-items: center; padding: 20rpx 24rpx; background: #1A365D; color: #fff; }
.back { font-size: 28rpx; padding: 8rpx 16rpx; }
.title { flex: 1; font-size: 28rpx; text-align: center; }
.info { font-size: 24rpx; }
.scroll-area { flex: 1; }
.exam-section { margin: 24rpx; }
.section-label { font-size: 26rpx; font-weight: 600; color: #1A202C; margin-bottom: 16rpx; padding-left: 12rpx; border-left: 6rpx solid #1A365D; }
.page-img { width: 100%; border-radius: 12rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1); }
.answer-section { margin: 24rpx; padding: 24rpx; background: #fff; border-radius: 16rpx; }
.answer-item { display: flex; align-items: center; margin-bottom: 16rpx; }
.answer-num { font-size: 24rpx; color: #1A365D; font-weight: 600; width: 100rpx; flex-shrink: 0; }
.answer-input { flex: 1; height: 64rpx; background: #F7F8FA; border-radius: 8rpx; padding: 0 20rpx; font-size: 26rpx; border: 2rpx solid #E2E8F0; }
.empty-hint { text-align: center; color: #A0AEC0; font-size: 26rpx; padding: 40rpx 0; }
.submit-btn { background: #1A365D; color: #fff; border-radius: 12rpx; padding: 24rpx; text-align: center; font-size: 28rpx; margin-top: 20rpx; }
.result-area { margin-top: 24rpx; }
.result-item { padding: 16rpx; border-radius: 8rpx; margin-bottom: 8rpx; font-size: 24rpx; }
.result-item.correct { background: rgba(16,185,129,0.1); }
.result-item.wrong { background: rgba(239,68,68,0.1); }
.result-label { font-weight: 600; margin-right: 12rpx; }
.result-answer { color: #10B981; margin-left: 12rpx; }
.page-nav-row { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; margin: 24rpx; background: #fff; border-radius: 12rpx; }
.nav-btn { font-size: 26rpx; color: #1A365D; padding: 12rpx 24rpx; }
.nav-btn.disabled { opacity: 0.3; }
.page-indicator { font-size: 24rpx; color: #A0AEC0; }
