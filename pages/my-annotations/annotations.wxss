.page-container {
  padding: 0 32rpx;
  padding-bottom: 100rpx;
  padding-top: 32rpx;
}
.ann-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.ann-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.ann-source { display: flex; gap: 16rpx; }
.ann-file { font-size: 24rpx; color: #1A365D; font-weight: 500; }
.ann-page { font-size: 22rpx; color: #A0AEC0; }
.ann-date { font-size: 22rpx; color: #A0AEC0; }
.ann-body {
  font-size: 28rpx;
  line-height: 1.6;
  color: #1A202C;
  font-style: italic;
  padding: 16rpx;
  background: #F7F8FA;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}
.ann-actions { display: flex; gap: 32rpx; }
.ann-action { font-size: 24rpx; color: #1A365D; }
.del-action { color: #EF4444; }
