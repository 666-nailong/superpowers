<view class="page-container">
  <!-- 顶部问候 -->
  <view class="welcome-section">
    <view class="welcome-avatar">⚡</view>
    <view class="welcome-text">
      <view class="welcome-title">电路分析学习助手</view>
      <view class="welcome-subtitle">{{greeting}}，今天也要加油！</view>
    </view>
  </view>

  <!-- 学习进度卡片 -->
  <view class="card stats-card">
    <view class="stats-row">
      <view class="stat-item" bindtap="goCourseware">
        <view class="stat-num">{{chapters.length}}</view>
        <view class="stat-label">总章节</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{accuracy}}%</view>
        <view class="stat-label">正确率</view>
      </view>
      <view class="stat-item" bindtap="goWrongBook">
        <view class="stat-num" style="color: var(--danger)">{{wrongCount}}</view>
        <view class="stat-label">错题数</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{wrongCount > 0 ? '继续加油' : '0'}}</view>
        <view class="stat-label">待复习</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{studyHours}}h</view>
        <view class="stat-label">学习时长</view>
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="section-title">快捷入口</view>
  <view class="quick-grid">
    <view class="quick-item" bindtap="goCourseware">
      <view class="quick-icon" style="background: rgba(26,54,93,0.1)">📖</view>
      <text class="quick-label">课件目录</text>
    </view>
    <view class="quick-item" bindtap="goPractice">
      <view class="quick-icon" style="background: rgba(59,130,246,0.1)">📝</view>
      <text class="quick-label">刷题练习</text>
    </view>
    <view class="quick-item" bindtap="goWrongBook">
      <view class="quick-icon" style="background: rgba(239,68,68,0.1)">📕</view>
      <text class="quick-label">错题重做</text>
    </view>
    <view class="quick-item" bindtap="goMockExam">
      <view class="quick-icon" style="background: rgba(16,185,129,0.1)">📊</view>
      <text class="quick-label">模拟考试</text>
    </view>
  </view>

  <!-- 使用说明 -->
  <view class="section-title">💡 使用说明</view>
  <view class="card help-card">
    <view class="help-item" bindtap="toggleHelp" data-key="ai">
      <text>{{helpExpanded.ai ? '▼' : '▶'}} 🤖 AI答疑说明</text>
    </view>
    <view wx:if="{{helpExpanded.ai}}" class="help-body">
      <view class="help-text">本小程序内置两种AI回答方式：</view>
      <view class="help-text">1️⃣ 🆓 免费本地引擎：无需任何设置，从课件PDF中检索答案（默认）</view>
      <view class="help-text">2️⃣ 🌐 AI大模型：需自行配置API Key，回答更强大（可选）</view>
      <view class="help-link" bindtap="showFreeApiGuide">👉 点击查看如何免费获取API Key</view>
      <view class="help-link" bindtap="showQualityPicker" style="margin-top:4rpx">🖼️ 切换课件图片清晰度（当前：标准）</view>
    </view>
    <view class="help-item" bindtap="toggleHelp" data-key="study">
      <text>{{helpExpanded.study ? '▼' : '▶'}} 📖 学习流程</text>
    </view>
    <view wx:if="{{helpExpanded.study}}" class="help-body">
      <text class="help-text">① 课件学习：看PDF课件 → 添加批注 → AI提问</text>
      <text class="help-text">② 题库练习：章节刷题 → 真题模拟 → 错题重做</text>
      <text class="help-text">③ 公式速查：按分类查找 → 查看推导过程</text>
    </view>

    <view class="help-item" bindtap="toggleHelp" data-key="feature">
      <text>{{helpExpanded.feature ? '▼' : '▶'}} ✨ 特色功能</text>
    </view>
    <view wx:if="{{helpExpanded.feature}}" class="help-body">
      <text class="help-text">• 课件批注：在PDF上添加/查看批注，支持点赞回复</text>
      <text class="help-text">• 错题本：自动记录错题，可按章节筛选重做</text>
      <text class="help-text">• 模拟考试：随机组卷限时答题</text>
      <text class="help-text">• 真题原卷：查看历年真题扫描件</text>
      <text class="help-text">• 公式推导：展开查看公式的完整推导过程</text>
    </view>
  </view>

  <!-- 学习动态 -->
  <view class="section-title">学习动态</view>
  <view class="card">
    <view wx:if="{{recentActivities.length === 0}}" class="empty-state">
      <view>开始你的电路分析学习之旅吧！</view>
    </view>
    <view wx:for="{{recentActivities}}" wx:key="index" class="activity-item">
      <view class="activity-icon">{{item.icon}}</view>
      <view class="activity-content">
        <view class="activity-text">{{item.text}}</view>
        <view class="activity-time">{{item.time}}</view>
      </view>
    </view>
  </view>

  <!-- 课程大纲 -->
  <view class="section-title">课程大纲</view>
  <view class="card chapter-nav">
    <view wx:for="{{chapters}}" wx:key="id" class="chapter-item" data-id="{{item.id}}" bindtap="goChapter">
      <view class="chapter-num">{{item.order}}</view>
      <view class="chapter-info">
        <view class="chapter-name">{{item.title}}</view>
        <view class="chapter-status" wx:if="{{item.completed}}">✅ 已完成</view>
      </view>
      <view class="chapter-arrow">›</view>
    </view>
  </view>
</view>
