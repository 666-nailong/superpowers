.page-container {
  padding: 0 32rpx;
  padding-bottom: 120rpx;
}

/* 欢迎区 */
.welcome-section {
  display: flex;
  align-items: center;
  padding: 48rpx 0 32rpx;
}
.welcome-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #1A365D;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.welcome-text {
  flex: 1;
}
.welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A365D;
}
.welcome-subtitle {
  font-size: 26rpx;
  color: #4A5568;
  margin-top: 8rpx;
}

/* 统计卡片 */
.stats-card {
  padding: 28rpx 24rpx;
}
.stats-row {
  display: flex;
  justify-content: space-between;
}
.stat-item {
  text-align: center;
  flex: 1;
}
.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A365D;
}
.stat-label {
  font-size: 22rpx;
  color: #A0AEC0;
  margin-top: 8rpx;
}

/* 快捷入口 */
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.quick-item {
  width: 48%;
  margin-bottom: 20rpx;
}
.quick-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 16rpx;
}
.quick-label {
  font-size: 26rpx;
  color: #1A202C;
  font-weight: 500;
}

/* 活动记录 */
.activity-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #E2E8F0;
}
.activity-item:last-child { border-bottom: none; }
.activity-icon { font-size: 32rpx; margin-right: 20rpx; }
.activity-content { flex: 1; }
.activity-text { font-size: 26rpx; color: #1A202C; }
.activity-time { font-size: 22rpx; color: #A0AEC0; margin-top: 4rpx; }
.empty-hint { font-size: 24rpx; color: #A0AEC0; margin-top: 12rpx; }

/* 章节导航 */
.chapter-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #E2E8F0;
}
.chapter-item:last-child { border-bottom: none; }
.chapter-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #1A365D;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.chapter-info { flex: 1; }
.chapter-name { font-size: 28rpx; color: #1A202C; }
.chapter-status { font-size: 22rpx; color: #10B981; margin-top: 4rpx; }
.chapter-arrow { font-size: 36rpx; color: #A0AEC0; }
